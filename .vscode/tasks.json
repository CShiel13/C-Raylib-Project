{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build Emergency City Simulation",
            "command": "clang -std=c99 -Wall -Wextra main.c simulation.c -o main $(pkg-config --cflags --libs raylib) -lm",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "shell",
            "label": "Run Event and Condition Checks",
            "command": "clang -std=c99 -Wall -Wextra feature_event_condition_check.c simulation.c -o feature_event_condition_check $(pkg-config --cflags --libs raylib) -lm && ./feature_event_condition_check",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "type": "shell",
            "label": "Run Resized UI Click Checks",
            "command": "clang -std=c99 -Wall -Wextra ui_click_check.c -o ui_click_check $(pkg-config --cflags --libs raylib) -lm && ./ui_click_check",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}
